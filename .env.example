# TRACE-X Environment Configuration Template
PROJECT_NAME="TRACE-X"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./tracex.db"

# Neo4j Property Graph
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="change-me-neo4j-password"

# Analytical Model Configuration
STYLOMETRY_MODEL="sentence-transformers/all-mpnet-base-v2"
ENABLE_REAL_TRANSFORMER=true
